# Supabase Configuration
# Copy this file to .env.local and fill in your values

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# BugSnag Error Monitoring
VITE_BUGSNAG_API_KEY=your-bugsnag-api-key

# Mailtrap (used by Supabase local dev for email testing)
MAILTRAP_PASSWORD=your-mailtrap-password

# Cloudflare Turnstile (bot protection)
VITE_CLOUDFLARE_TURNSTILE_SITEKEY=your-turnstile-sitekey
CLOUDFLARE_TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# Ordnance Survey Names API (free — https://osdatahub.os.uk)
VITE_OS_NAMES_API_KEY=your-os-names-api-key

# Google Analytics 4
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
